generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum shippingstatus{
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  size       Int[]       @default([])
  weight     String?
  imgurl     String?
  unit       String
  price      Float
  descr      String?
  sku        String      @unique
  categoryId Int
  isVisible  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  packaging  Int?
  LooseSell  Boolean     @default(false)
  partnerId  String      @default("a90ad93a-98f8-4ef8-9faa-01649e58047b")
  partnername  String      @default("Techno")
  orderItems OrderItem[]
  category   Category    @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Customer {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String   @unique
  email         String?  @unique
  isDistributor Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Address       String?
  pincode       String?
  orders        Order[]
    pushSubscriptions PushSubscription[]
}


model Order {
  id         String      @id @default(uuid())
  customerId Int
  paid       Boolean
  paymentid  String
  delivered  Boolean
  complete   Boolean
  total      Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      OrderItem[]

  @@index([customerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String
  productId Int
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  shippingStatus shippingstatus @default(PENDING)
  shippedBy      String?        // Partner ID who shipped it
  shippedAt      DateTime?      // When it was shipped
  @@index([orderId, productId])
}

model Partner {
  id       String @id @default(uuid())
  username String @unique
  password String @unique
  name     String  
}
  model PushSubscription {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  customerId String?      // optional: link to your Customer
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [phone])
}

enum DeliveryChargeType {
  FIXED      // Fixed minimum charge
  PERCENTAGE // Percentage of cart total
  BOTH       // Use whichever is higher (min charge or percentage)
}

model DeliverySettings {
  id                Int               @id @default(autoincrement())
  isActive          Boolean           @default(true)
  chargeType        DeliveryChargeType @default(PERCENTAGE)
  minCharge         Float              @default(0)      // Minimum delivery charge (for FIXED or BOTH types)
  percentageCharge  Float              @default(8)     // Percentage to charge (for PERCENTAGE or BOTH types)
  freeDeliveryAbove Float              @default(500)   // Free delivery above this amount
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PincodeDelivery {
  id                Int               @id @default(autoincrement())
  pincode           String            @unique         // 6-digit pincode
  regionName        String?                           // Region from CSV
  divisionName      String?                           // Division from CSV
  district          String?                           // District from CSV
  stateName         String?                           // State from CSV
  isDelivery        Boolean           @default(true)  // true = delivery available, false = no delivery
  chargeType        DeliveryChargeType @default(PERCENTAGE) // Override default charge type
  minCharge         Float?                           // Override minimum charge
  percentageCharge  Float?                           // Override percentage charge
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([pincode])
  @@index([district])
  @@index([stateName])
}